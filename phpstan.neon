parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - vendor
        - tests
        - src/storage/Eloquent
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Laravel helper functions not available in standalone environment
        - '#Function config not found#'
        - '#Function now not found#'
        # Readonly property assignment in constructor (false positive)
        - '#Readonly property .* is already assigned#'
        # Dead catch in PluginRegistry - false positive (dynamic instantiation can fail)
        -
            message: '#Dead catch - Throwable is never thrown in the try block#'
            path: src/core/Plugin/PluginRegistry.php
        # Doctrine ORM attributes - optional dependency not included in core
        - '#Attribute class Doctrine\\ORM\\Mapping\\.* does not exist#'
